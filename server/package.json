{
  "name": "conexsur-servidor",
  "version": "0.1.0",
  "private": true,
  "description": "API de CONEXSUR: gestión, agendamiento y pagos para proveedor de conectividad",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "migrar": "node --env-file=.env src/db/migrar.js",
    "semilla": "node --env-file=.env src/db/semilla.js",
    "test": "node --test --test-concurrency=1 --env-file=.env.test tests/*.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
