# Copiar a .env y completar. NUNCA subir .env al repositorio.
NODE_ENV=development
PUERTO=3000
# Conexión a PostgreSQL
DATABASE_URL=postgresql://conexsur:cambiar_clave@localhost:5432/conexsur
# Secreto para firmar las sesiones (mínimo 32 caracteres). Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=cambiar_por_un_secreto_largo_y_aleatorio_de_32_o_mas_caracteres
# Duración de la sesión
JWT_EXPIRA_HORAS=8
# Origen permitido del cliente web (CORS)
ORIGEN_CLIENTE=http://localhost:5173
# Mercado Pago (se usan desde el ciclo de pagos; credenciales de PRUEBA hasta el paso a producción)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRETO=
